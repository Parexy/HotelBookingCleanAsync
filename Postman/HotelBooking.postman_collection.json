            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();\r",
                  "const endDate = new Date();\r",
                  "\r",
                  "// +1 day\r",
                  "now.setDate(now.getDate() + 1);\r",
                  "endDate.setDate(now.getDate() + 2);\r",
                  "\r",
                  "// Store as ISO string\r",
                  "pm.environment.set(\"startDate\", now.toISOString());\r",
                  "pm.environment.set(\"endDate\", endDate.toISOString());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
