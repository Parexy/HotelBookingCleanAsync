        {
          "name": "UpdateBooking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();\r",
                  "const endDate = new Date();\r",
                  "\r",
                  "// +1 day\r",
                  "now.setDate(now.getDate() + 2);\r",
                  "endDate.setDate(now.getDate() + 3);\r",
                  "\r",
                  "// Store as ISO string\r",
                  "pm.environment.set(\"startDate\", now.toISOString());\r",
                  "pm.environment.set(\"endDate\", endDate.toISOString());\r",
                  "\r",
                  "const body = JSON.parse(pm.environment.get(\"lastResponseBody\"));\r",
                  "\r",
                  "pm.environment.set(\"bodyID\", body.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
